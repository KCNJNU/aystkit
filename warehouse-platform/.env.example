# Internal warehouse: server configuration
POSTGRES_DB=cleaning_robot
POSTGRES_USER=cleaning_robot
POSTGRES_PASSWORD='YOUR_POSTGRES_PASSWORD'
DATABASE_URL='postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@postgres:5432/YOUR_DATABASE_NAME?schema=public'
OBJECT_STORAGE_ENDPOINT=localhost
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_USE_SSL=false
OBJECT_STORAGE_BUCKET=robot-raw-files
OBJECT_STORAGE_ACCESS_KEY='YOUR_OBJECT_STORAGE_ACCESS_KEY'
OBJECT_STORAGE_SECRET_KEY='YOUR_OBJECT_STORAGE_SECRET_KEY'
DVC_COMMAND=dvc
DVC_REPOSITORY_ROOT=
DVC_REMOTE_NAME=robot-dvc
DVC_REMOTE_ENDPOINT=localhost
DVC_REMOTE_PORT=9000
DVC_REMOTE_USE_SSL=false
DVC_REMOTE_BUCKET=robot-dvc-store
DVC_REMOTE_ACCESS_KEY='YOUR_DVC_REMOTE_ACCESS_KEY'
DVC_REMOTE_SECRET_KEY='YOUR_DVC_REMOTE_SECRET_KEY'
DATASET_PUBLISH_GIT_AUTHOR_NAME=Cleaning Robot Dataset Publisher
DATASET_PUBLISH_GIT_AUTHOR_EMAIL=dataset-publisher@example.invalid
MINIO_ROOT_USER='YOUR_MINIO_ROOT_USER'
MINIO_ROOT_PASSWORD='YOUR_MINIO_ROOT_PASSWORD'
API_PORT=3000
WEB_HOST=0.0.0.0
WEB_PORT=5173
WEB_HMR_HOST=
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://*:5173
VITE_API_BASE_URL=http://localhost:3000
REDIS_HOST=localhost
REDIS_PORT=6379
BOOTSTRAP_ADMIN_EMAIL=admin@cleaning-robot.local
BOOTSTRAP_ADMIN_PASSWORD='YOUR_BOOTSTRAP_ADMIN_PASSWORD'
AUTH_SESSION_HOURS=12
# HTTP localhost/LAN: false; HTTPS: true. If unset, production defaults to true.
AUTH_COOKIE_SECURE=false
WORKER_CONCURRENCY=2
APP_VERSION=0.0.0-dev
GIT_COMMIT=unknown
BUILD_TIME=unknown
DEPLOYMENT_ENVIRONMENT=DEV
RATE_LIMIT_KEY_SALT=development-only-rate-limit-salt
RETENTION_EXECUTION_ENABLED=false
RELEASE_VERSION=0.0.0-dev
SLOT=local

# Qwen: server only; never expose these variables to Vite
QWEN_API_KEY='YOUR_QWEN_API_KEY'
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TIMEOUT=30000
QWEN_MAX_TOKENS=2048

# Optional public hostname/IP reachable by browsers; enable-lan.ps1 sets the LAN IP.
# Host only, without http:// or a path.
OBJECT_STORAGE_PUBLIC_ENDPOINT=
OBJECT_STORAGE_PUBLIC_PORT=9000
