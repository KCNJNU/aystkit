# Robot-side configuration only; do not put viewer credentials on the robot.
CLOUD_URL=https://observer.example.invalid
ROBOT_ID=replace-robot-id
SOURCE_ID=replace-rk-source
DEVICE_TOKEN=YOUR_DEVICE_TOKEN
COLLECTOR_ROLE=primary
# Explicit single authority for chassis feedback. Default ROS2; opt-in local_ws
# only receives existing loopback 8765 broadcasts, never sends control messages.
COLLECTOR_CHASSIS_SOURCE=ros2
ALLOW_INSECURE_LOCAL=false
# Examples only; set these to the existing publisher's actual ROS environment.
# ROS_DOMAIN_ID=0
# RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Preserve existing discovery settings; do not invent a new DDS domain.
# ROBOT_ROS_SETUP=/home/orangepi/code/upper_computer/install/setup.bash
# COLLECTOR_TOPIC_REGISTERED=/cloud_registered_body_xyzi
# COLLECTOR_TOPIC_BLUESEA=/bluesea_new/scan
# COLLECTOR_IMAGE_FPS=1
# Optional HTTP-only rate, 0.1..2; requires enabled HTTP input. ROS rate is unchanged.
# COLLECTOR_HTTP_CAMERA_FPS=2
# COLLECTOR_CLOUD_FPS=1
# COLLECTOR_CLOUD_POINTS=1500
# COLLECTOR_MEDIA_KEYS=fisheye,color,depth,lidar,registered,depthPoints,map,localCostmap,globalCostmap
# Berxel 跨机预览使用 bridge，须先在 Jetson 启动已有压缩桥；默认 raw。
# bridge 仅停用 Berxel 彩色、深度、深度点云的原始订阅，其他数据来源不变。
# COLLECTOR_BERXEL_TRANSPORT=raw
