# Install as ~/.config/robot-cloud/warehouse-upload-tunnel.env, mode 0600.
# Create a dedicated upload key; never use the root deployment identity here.
WAREHOUSE_CLOUD_HOST=8.140.19.17
WAREHOUSE_CLOUD_KEY=/home/user/.ssh/robot_warehouse_upload_ed25519
WAREHOUSE_CLOUD_KNOWN_HOSTS=/home/user/.ssh/known_hosts_ecs_video
WAREHOUSE_CLOUD_BIND_INTERFACE=auto
# Keep old in-flight upload clients on loopback 3000 connected to the same
# cloud API, without restarting recording. Stop the old API before cutover.
WAREHOUSE_CLOUD_LEGACY_API_ALIAS=true
