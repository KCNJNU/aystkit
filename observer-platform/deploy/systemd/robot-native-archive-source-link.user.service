[Unit]
Description=Private source archive upload and garage-choice synchronization
After=network-online.target robot-native-archive.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=%h/.config/robot-cloud/archive.env
WorkingDirectory=%h/.local/share/robot-cloud
ExecStart=/usr/bin/python3 -m collector.archive_source_link
Restart=always
RestartSec=10
NoNewPrivileges=yes
UMask=0077
Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=default.target
