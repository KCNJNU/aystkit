# Jetson 上仅供网页使用的 Berxel 压缩预览；不修改驱动的原始采集参数。
# 640×400 原图按比例预览为 480×300，鱼眼和四路 H.264 摄像机不受影响。
BERXEL_PREVIEW_MAX_EDGE=480
BERXEL_PREVIEW_JPEG_QUALITY=45
BERXEL_PREVIEW_IMAGE_FPS=5
BERXEL_PREVIEW_CLOUD_POINTS=900
BERXEL_PREVIEW_CLOUD_FPS=2
# 工控机现有 collector.env 另设 COLLECTOR_IMAGE_FPS=2；
# 保留 COLLECTOR_BERXEL_TRANSPORT=bridge 和 COLLECTOR_CLOUD_FPS=1。
# 以上仅影响预览，原始点云和机器人控制保持原配置。
