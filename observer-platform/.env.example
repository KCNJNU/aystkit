# Copy to .env; replace every replace-* value before production startup.
ROBOT_ID=replace-robot-id
DEVICE_CREDENTIALS_JSON=YOUR_DEVICE_CREDENTIALS_JSON
VIEWER_USERNAME=YOUR_VIEWER_USERNAME
# Generate with: python deploy/scripts/hash_password.py
# Single quotes protect the $ signs from Docker Compose interpolation.
VIEWER_PASSWORD_HASH=YOUR_VIEWER_PASSWORD_HASH
SESSION_SECRET=YOUR_SESSION_SECRET
PUBLIC_ORIGIN=https://observer.example.invalid
ALLOW_INSECURE_LOCAL=false
DATA_DIR=./data
PORT=8888
HOST=0.0.0.0
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128,172.30.88.0/24
CLOUD_SUBNET=172.30.88.0/24
# Deployment scripts override this with the actual tested Git commit and persist it.
CLOUD_IMAGE_TAG=local
TLS_DIR=./tls
# Optional official image registry alternatives when Docker Hub is unreachable.
PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
NGINX_IMAGE=nginx:1.28-alpine
# Optional existing native H.264 preview. Empty socket keeps JPEG compatibility.
NATIVE_VIDEO_SOCKET=
NATIVE_VIDEO_MAX_PLAYING=4
NATIVE_VIDEO_SPLIT_SOCKETS=false
# ECS public IP / domain / SSH user are operator supplied; no SSH actions run automatically.
